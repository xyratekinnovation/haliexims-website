# Public site origin (no trailing slash) — used for canonical + Open Graph URLs
VITE_SITE_URL=https://haliexims.com

# Contact details shown on the site
VITE_CONTACT_EMAIL=halieximsindia@gmail.com
VITE_CONTACT_PHONE_DISPLAY=+91 98430 44445
VITE_CONTACT_PHONE_TEL=+919843044445
# WhatsApp number digits only (country code + number, no + or spaces)
VITE_WHATSAPP=919843044445

# Optional — leave empty to hide LinkedIn in the top bar / footer
VITE_LINKEDIN_URL=https://www.linkedin.com/company/haliexims

# ---------------------------------------------------------------------------
# Contact form SMTP (server-only — put these in `.env.local`, never commit secrets)
# Recommended: Gmail with an App Password (Google Account → Security → App passwords)
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=halieximsindia@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM="HALI EXIMS Website <halieximsindia@gmail.com>"
